CREATE TABLE meta (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE TABLE contact (
  id TEXT NOT NULL PRIMARY KEY,
  display_name TEXT NOT NULL,
  organization TEXT,
  job_title TEXT,
  kind TEXT NOT NULL DEFAULT 'unspecified',
  android_lookup_key TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  updated_by TEXT NOT NULL,
  deleted_at INTEGER
);

CREATE TABLE phone (
  id TEXT NOT NULL PRIMARY KEY,
  contact_id TEXT NOT NULL REFERENCES contact(id),
  raw TEXT NOT NULL,
  normalized TEXT NOT NULL,
  label TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  updated_by TEXT NOT NULL,
  deleted_at INTEGER
);

CREATE TABLE email (
  id TEXT NOT NULL PRIMARY KEY,
  contact_id TEXT NOT NULL REFERENCES contact(id),
  address TEXT NOT NULL,
  label TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  updated_by TEXT NOT NULL,
  deleted_at INTEGER
);

CREATE TABLE note (
  id TEXT NOT NULL PRIMARY KEY,
  contact_id TEXT NOT NULL REFERENCES contact(id),
  body TEXT NOT NULL,
  source TEXT NOT NULL,
  call_direction TEXT,
  call_number_raw TEXT,
  call_number_normalized TEXT,
  occurred_at INTEGER NOT NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  updated_by TEXT NOT NULL,
  deleted_at INTEGER
);

CREATE TABLE tag (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  updated_by TEXT NOT NULL,
  deleted_at INTEGER
);

CREATE TABLE contact_tag (
  id TEXT NOT NULL PRIMARY KEY,
  contact_id TEXT NOT NULL REFERENCES contact(id),
  tag_id TEXT NOT NULL REFERENCES tag(id),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  updated_by TEXT NOT NULL,
  deleted_at INTEGER
);

CREATE TABLE reminder (
  id TEXT NOT NULL PRIMARY KEY,
  contact_id TEXT NOT NULL REFERENCES contact(id),
  note_id TEXT REFERENCES note(id),
  body TEXT NOT NULL,
  due_at INTEGER NOT NULL,
  done_at INTEGER,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  updated_by TEXT NOT NULL,
  deleted_at INTEGER
);

CREATE INDEX phone_normalized ON phone(normalized);
CREATE INDEX phone_contact ON phone(contact_id);
CREATE INDEX email_contact ON email(contact_id);
CREATE INDEX note_contact_occurred ON note(contact_id, occurred_at);
CREATE INDEX contact_tag_contact ON contact_tag(contact_id);
CREATE INDEX contact_tag_tag ON contact_tag(tag_id);
CREATE INDEX reminder_open_due ON reminder(done_at, due_at);
CREATE UNIQUE INDEX contact_lookup ON contact(android_lookup_key);

upsertMeta:
INSERT INTO meta(key, value)
VALUES (:key, :value)
ON CONFLICT(key) DO UPDATE SET value = excluded.value;

selectMeta:
SELECT value FROM meta WHERE key = :key;

upsertContact:
INSERT INTO contact(
  id, display_name, organization, job_title, kind, android_lookup_key,
  created_at, updated_at, updated_by, deleted_at
) VALUES (
  :id, :displayName, :organization, :jobTitle, :kind, :androidLookupKey,
  :createdAt, :updatedAt, :updatedBy, :deletedAt
)
ON CONFLICT(id) DO UPDATE SET
  display_name = excluded.display_name,
  organization = excluded.organization,
  job_title = excluded.job_title,
  kind = excluded.kind,
  android_lookup_key = excluded.android_lookup_key,
  created_at = excluded.created_at,
  updated_at = excluded.updated_at,
  updated_by = excluded.updated_by,
  deleted_at = excluded.deleted_at;

selectAllContacts:
SELECT * FROM contact;

selectContact:
SELECT * FROM contact WHERE id = :id;

selectContactByLookup:
SELECT * FROM contact WHERE android_lookup_key = :lookupKey;

upsertPhone:
INSERT INTO phone(
  id, contact_id, raw, normalized, label, created_at, updated_at, updated_by, deleted_at
) VALUES (
  :id, :contactId, :raw, :normalized, :label, :createdAt, :updatedAt, :updatedBy, :deletedAt
)
ON CONFLICT(id) DO UPDATE SET
  contact_id = excluded.contact_id,
  raw = excluded.raw,
  normalized = excluded.normalized,
  label = excluded.label,
  created_at = excluded.created_at,
  updated_at = excluded.updated_at,
  updated_by = excluded.updated_by,
  deleted_at = excluded.deleted_at;

selectAllPhones:
SELECT * FROM phone;

selectPhonesForContact:
SELECT * FROM phone WHERE contact_id = :contactId;

upsertEmail:
INSERT INTO email(
  id, contact_id, address, label, created_at, updated_at, updated_by, deleted_at
) VALUES (
  :id, :contactId, :address, :label, :createdAt, :updatedAt, :updatedBy, :deletedAt
)
ON CONFLICT(id) DO UPDATE SET
  contact_id = excluded.contact_id,
  address = excluded.address,
  label = excluded.label,
  created_at = excluded.created_at,
  updated_at = excluded.updated_at,
  updated_by = excluded.updated_by,
  deleted_at = excluded.deleted_at;

selectAllEmails:
SELECT * FROM email;

selectEmailsForContact:
SELECT * FROM email WHERE contact_id = :contactId;

upsertNote:
INSERT INTO note(
  id, contact_id, body, source, call_direction, call_number_raw, call_number_normalized,
  occurred_at, created_at, updated_at, updated_by, deleted_at
) VALUES (
  :id, :contactId, :body, :source, :callDirection, :callNumberRaw, :callNumberNormalized,
  :occurredAt, :createdAt, :updatedAt, :updatedBy, :deletedAt
)
ON CONFLICT(id) DO UPDATE SET
  contact_id = excluded.contact_id,
  body = excluded.body,
  source = excluded.source,
  call_direction = excluded.call_direction,
  call_number_raw = excluded.call_number_raw,
  call_number_normalized = excluded.call_number_normalized,
  occurred_at = excluded.occurred_at,
  created_at = excluded.created_at,
  updated_at = excluded.updated_at,
  updated_by = excluded.updated_by,
  deleted_at = excluded.deleted_at;

selectAllNotes:
SELECT * FROM note;

selectNote:
SELECT * FROM note WHERE id = :id;

selectVisibleNotesForContact:
SELECT * FROM note
WHERE contact_id = :contactId AND deleted_at IS NULL
ORDER BY occurred_at DESC;

upsertTag:
INSERT INTO tag(id, name, created_at, updated_at, updated_by, deleted_at)
VALUES (:id, :name, :createdAt, :updatedAt, :updatedBy, :deletedAt)
ON CONFLICT(id) DO UPDATE SET
  name = excluded.name,
  created_at = excluded.created_at,
  updated_at = excluded.updated_at,
  updated_by = excluded.updated_by,
  deleted_at = excluded.deleted_at;

selectAllTags:
SELECT * FROM tag;

selectTag:
SELECT * FROM tag WHERE id = :id;

upsertContactTag:
INSERT INTO contact_tag(
  id, contact_id, tag_id, created_at, updated_at, updated_by, deleted_at
) VALUES (
  :id, :contactId, :tagId, :createdAt, :updatedAt, :updatedBy, :deletedAt
)
ON CONFLICT(id) DO UPDATE SET
  contact_id = excluded.contact_id,
  tag_id = excluded.tag_id,
  created_at = excluded.created_at,
  updated_at = excluded.updated_at,
  updated_by = excluded.updated_by,
  deleted_at = excluded.deleted_at;

selectAllContactTags:
SELECT * FROM contact_tag;

selectContactTagsForContact:
SELECT * FROM contact_tag WHERE contact_id = :contactId;

selectContactTagsForTag:
SELECT * FROM contact_tag WHERE tag_id = :tagId;

updateContactTagTarget:
UPDATE contact_tag
SET tag_id = :tagId, updated_at = :updatedAt, updated_by = :updatedBy
WHERE id = :id;

upsertReminder:
INSERT INTO reminder(
  id, contact_id, note_id, body, due_at, done_at, created_at, updated_at, updated_by, deleted_at
) VALUES (
  :id, :contactId, :noteId, :body, :dueAt, :doneAt, :createdAt, :updatedAt, :updatedBy, :deletedAt
)
ON CONFLICT(id) DO UPDATE SET
  contact_id = excluded.contact_id,
  note_id = excluded.note_id,
  body = excluded.body,
  due_at = excluded.due_at,
  done_at = excluded.done_at,
  created_at = excluded.created_at,
  updated_at = excluded.updated_at,
  updated_by = excluded.updated_by,
  deleted_at = excluded.deleted_at;

selectAllReminders:
SELECT * FROM reminder;

selectReminder:
SELECT * FROM reminder WHERE id = :id;

searchContactIds:
SELECT DISTINCT contact.id
FROM contact
LEFT JOIN phone ON phone.contact_id = contact.id AND phone.deleted_at IS NULL
LEFT JOIN email ON email.contact_id = contact.id AND email.deleted_at IS NULL
LEFT JOIN contact_tag ON contact_tag.contact_id = contact.id AND contact_tag.deleted_at IS NULL
LEFT JOIN tag ON tag.id = contact_tag.tag_id AND tag.deleted_at IS NULL
LEFT JOIN reminder ON reminder.contact_id = contact.id AND reminder.deleted_at IS NULL
LEFT JOIN note ON note.contact_id = contact.id AND note.deleted_at IS NULL
WHERE contact.deleted_at IS NULL
  AND (
    contact.display_name LIKE '%' || :term || '%'
    OR IFNULL(contact.organization, '') LIKE '%' || :term || '%'
    OR IFNULL(phone.raw, '') LIKE '%' || :term || '%'
    OR IFNULL(email.address, '') LIKE '%' || :term || '%'
    OR IFNULL(tag.name, '') LIKE '%' || :term || '%'
    OR IFNULL(reminder.body, '') LIKE '%' || :term || '%'
    OR IFNULL(note.body, '') LIKE '%' || :term || '%'
  );
